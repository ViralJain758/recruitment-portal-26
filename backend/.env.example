# development | production. In production, cookies use secure defaults and
# HTTPS is enforced. Use development for local npm run dev.
NODE_ENV=development
PORT=5000

# Required in production. Use one or more comma-separated frontend origins.
CLIENT_ORIGIN=http://localhost:5173

# debug | info | warn | error
LOG_LEVEL=info

TURSO_DATABASE_URL=your-turso-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Upstash QStash Serverless Queueing (Recommended for Vercel)
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key
APP_BASE_URL=https://recruitment-portal-26-5jfu.vercel.app

# Redis buffers quiz-submission bursts before the worker writes to the
# database. Use a rediss:// URL when your managed Redis provider requires TLS.
REDIS_URL=redis://localhost:6379

# Number of queued quiz submissions written concurrently.
QUIZ_SUBMIT_CONCURRENCY=50

# Use long, random, unique values in production. Store real values in the
# deployment platform's secret manager, never in version control.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-real-password
ADMIN_OTP_EMAIL=admin-otp-recipient@example.com

SCANNER_PASSWORD=replace-with-a-real-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Recruitment Portal <no-reply@example.com>
