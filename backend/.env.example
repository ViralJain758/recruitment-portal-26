# development | production. Determines whether cookies are marked
# Secure/SameSite=None, HTTPS is enforced, and defaults are strict.
# Set this to "production" in your deployment platform's environment
# settings — leave it as "development" for local `npm run dev`.
NODE_ENV=development
PORT=5000
# In production, set this to your real frontend origin(s), comma-separated
# (e.g. https://recruit.example.com). Required when NODE_ENV=production —
# the server refuses to start without it so CORS never defaults to "allow
# everything".
CLIENT_ORIGIN=http://localhost:5173

# Controls log verbosity (debug | info | warn | error). Defaults to "info"
# in production, "debug" otherwise.
LOG_LEVEL=info

TURSO_DATABASE_URL=your-turso-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Use long, random, unique values in production, e.g. `openssl rand -hex 32`.
# Never commit real values — this file only documents which variables exist.
# In production, set these through your host's secret manager (Render/
# Railway/Fly "Secrets", AWS Secrets Manager, GCP Secret Manager, etc.),
# not a checked-in .env file.
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OTP_SECRET=replace-with-a-different-long-random-secret

ADMIN_EMAIL=admin@example.com
# Plaintext admin password for local/dev use. Keep the real value in your
# secret manager in production.
ADMIN_PASSWORD=replace-with-a-real-password
ADMIN_OTP_EMAIL=admin-otp-recipient@example.com

# Plaintext scanner PIN/password for local/dev use.
SCANNER_PASSWORD=replace-with-a-real-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Recruitment Portal <no-reply@example.com>
